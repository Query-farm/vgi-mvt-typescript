# name: test/sql/attach.test
# description: ATTACH a tileset as a database: one table per layer
# group: [mvt]

require vgi

require-env MVT_WORKER

require-env MVT_FIXTURES

require-env MVT_TILE_SERVER

statement ok
LOAD spatial;

# ---------------------------------------------------------------- PMTiles: one table per layer

statement ok
ATTACH 'mvt' AS sample (TYPE vgi, LOCATION '{MVT_WORKER}', tileset '{MVT_FIXTURES}/sample.pmtiles');

query T
SELECT table_name FROM duckdb_tables() WHERE database_name = 'sample' ORDER BY table_name;
----
cities
regions

# Attributes are typed columns; the default zoom is the tileset maxzoom (3).
query TRTI
SELECT name, population, capital, z FROM sample.cities ORDER BY population DESC;
----
Berlin	3645000.0	true	3
Paris	2148000.0	true	3
Vienna	1897000.0	true	3
Milan	1352000.0	false	3

query TTI
SELECT code, label, ST_NumInteriorRings(geometry) FROM sample.regions ORDER BY code;
----
A	Square with a hole	1
B	Triangle	0

query TT
SELECT column_name, column_type FROM (DESCRIBE sample.cities) WHERE column_name IN ('geometry', 'population', 'capital') ORDER BY column_name;
----
capital	BOOLEAN
geometry	GEOMETRY('OGC:CRS84')
population	DOUBLE

# Ordinary SQL on top: joins between layers, spatial predicates.
query TT
SELECT r.code, c.name FROM sample.regions r JOIN sample.cities c ON ST_Contains(r.geometry, c.geometry) ORDER BY ALL;
----
A	Milan

query T
SELECT name FROM sample.cities WHERE ST_Intersects(geometry, ST_MakeEnvelope(10, 44, 20, 50));
----
Vienna

# The reader functions are still there.
query TI
SELECT layer, count(*) FROM sample.main.read_tiles('{MVT_FIXTURES}/sample.pmtiles', zoom := 2) GROUP BY layer ORDER BY layer;
----
cities	4
regions	2

statement ok
DETACH sample;

# ---------------------------------------------------------------- zoom, coordinates (MBTiles is not ported; the same fixture as PMTiles)

statement ok
ATTACH 'mvt' AS mb (TYPE vgi, LOCATION '{MVT_WORKER}', tileset '{MVT_FIXTURES}/sample.pmtiles', zoom 1, coordinates 'web_mercator');

# At zoom 1 the fixture spans two tiles and Paris (2.35 E) also sits in the western tile's
# buffer. Each point is kept only in the tile that owns it, so it comes back once.
query III
SELECT count(*), count(DISTINCT name), max(z) FROM mb.cities;
----
4	4	1

query T
SELECT typeof(geometry) FROM mb.regions LIMIT 1;
----
GEOMETRY('EPSG:3857')

statement ok
DETACH mb;

# tile_edges 'raw' returns exactly what the tiles store, buffer copies included.
statement ok
ATTACH 'mvt' AS mbraw (TYPE vgi, LOCATION '{MVT_WORKER}', tileset '{MVT_FIXTURES}/sample.pmtiles', zoom 1, tile_edges 'raw');

query II
SELECT count(*), count(DISTINCT name) FROM mbraw.cities;
----
5	4

statement ok
DETACH mbraw;

# ---------------------------------------------------------------- features crossing tile edges

# edges.pmtiles: a line and a 20x12 degree rectangle that cross tile edges, plus one small
# feature of each kind; GDAL wrote no feature ids, so pieces join where they meet.
statement ok
ATTACH 'mvt' AS edges (TYPE vgi, LOCATION '{MVT_WORKER}', tileset '{MVT_FIXTURES}/edges.pmtiles');

query TTI
SELECT name, geometry_type, round(ST_Area(geometry)) FROM edges.areas ORDER BY name;
----
Four tiles	POLYGON	240
One tile	POLYGON	25

query TTI
SELECT name, geometry_type, round(ST_Length(geometry)) FROM edges.roads ORDER BY name;
----
Diagonal	LINESTRING	45
Short	LINESTRING	3

statement ok
ATTACH 'mvt' AS edgesclip (TYPE vgi, LOCATION '{MVT_WORKER}', tileset '{MVT_FIXTURES}/edges.pmtiles', tile_edges 'clip');

# Clipped pieces never overlap: they add up to the same area.
query II
SELECT count(*), round(sum(ST_Area(geometry))) FROM edgesclip.areas WHERE name = 'Four tiles';
----
4	240

statement ok
ATTACH 'mvt' AS edgesraw (TYPE vgi, LOCATION '{MVT_WORKER}', tileset '{MVT_FIXTURES}/edges.pmtiles', tile_edges 'raw');

query I
SELECT count(*) FROM edgesraw.areas WHERE name = 'Four tiles';
----
4

query I
SELECT round(sum(ST_Area(geometry))) > 240 FROM edgesraw.areas WHERE name = 'Four tiles';
----
true

# A pushed box narrows the tiles read; the feature is cut at the edge of the tiles read, so it
# still crosses the box edge and ST_Within stays exact.
query I
SELECT count(*) FROM edges.areas WHERE ST_Within(geometry, ST_MakeEnvelope(-20, 30, 0, 60));
----
0

query I
SELECT count(*) FROM edges.areas WHERE ST_Intersects(geometry, ST_MakeEnvelope(-20, 30, 0, 60));
----
1

statement ok
DETACH edges;

statement ok
DETACH edgesclip;

statement ok
DETACH edgesraw;

# ---------------------------------------------------------------- bbox scopes every table

statement ok
ATTACH 'mvt' AS pacific (TYPE vgi, LOCATION '{MVT_WORKER}', tileset '{MVT_FIXTURES}/sample.pmtiles', bbox '-170,-10,-160,0');

query I
SELECT count(*) FROM pacific.cities;
----
0

statement ok
ATTACH 'mvt' AS europe (TYPE vgi, LOCATION '{MVT_WORKER}', tileset '{MVT_FIXTURES}/sample.pmtiles', bbox '0,40,30,55');

query I
SELECT count(*) FROM europe.cities;
----
4

# max_tiles guards a layer table scan.
statement ok
ATTACH 'mvt' AS tiny (TYPE vgi, LOCATION '{MVT_WORKER}', tileset '{MVT_FIXTURES}/sample.pmtiles', zoom 1, max_tiles 1);

statement error
SELECT count(*) FROM tiny.cities;
----
<REGEX>:.*more than 1 tiles.*

# ---------------------------------------------------------------- spatial filter pushdown

# WHERE ST_Intersects(...) pushes a bounding-box hint into the scan: this table may read only
# one tile, and a box over the eastern tile succeeds where the whole table is refused (above).
query T
SELECT name FROM tiny.cities WHERE ST_Intersects(geometry, ST_MakeEnvelope(1, 40, 30, 55)) ORDER BY name;
----
Berlin
Milan
Paris
Vienna

# The hint narrows tiles; DuckDB still applies the exact predicate.
query T
SELECT name FROM tiny.cities WHERE ST_Within(geometry, ST_MakeEnvelope(8, 44, 17, 49)) ORDER BY name;
----
Milan
Vienna

# A box that covers no tile reads nothing.
query I
SELECT count(*) FROM tiny.cities WHERE ST_Intersects(geometry, ST_MakeEnvelope(-170, -10, -160, 0));
----
0

# Other pushed filters, including expressions the worker must evaluate, stay exact.
query T
SELECT name FROM tiny.cities WHERE ST_Intersects(geometry, ST_MakeEnvelope(1, 40, 30, 55)) AND name LIKE '%a%' AND population < 3000000 ORDER BY name;
----
Milan
Paris
Vienna

query T
SELECT name FROM tiny.cities WHERE ST_Intersects(geometry, ST_MakeEnvelope(1, 40, 30, 55)) AND lower(name) = 'paris';
----
Paris

# An OR derives no hint, so the guard still applies.
statement error
SELECT count(*) FROM tiny.cities WHERE ST_Intersects(geometry, ST_MakeEnvelope(1, 40, 30, 55)) OR name = 'x';
----
<REGEX>:.*more than 1 tiles.*

# The hint is read in the table's coordinate system.
statement ok
ATTACH 'mvt' AS tinymerc (TYPE vgi, LOCATION '{MVT_WORKER}', tileset '{MVT_FIXTURES}/sample.pmtiles', zoom 1, max_tiles 1, coordinates 'web_mercator');

query I
SELECT count(DISTINCT name) FROM tinymerc.cities WHERE ST_Intersects(geometry, ST_MakeEnvelope(1.1e5, 4.8e6, 3.4e6, 7.4e6));
----
4

# ---------------------------------------------------------------- remote PMTiles

statement ok
ATTACH 'mvt' AS remote (TYPE vgi, LOCATION '{MVT_WORKER}', tileset '{MVT_TILE_SERVER}/sample.pmtiles');

query I
SELECT count(*) FROM remote.regions;
----
2

# ---------------------------------------------------------------- without a tileset: functions only

statement ok
ATTACH 'mvt' AS plain (TYPE vgi, LOCATION '{MVT_WORKER}');

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'plain';
----
0

# ---------------------------------------------------------------- errors surface at ATTACH

statement error
ATTACH 'mvt' AS missing (TYPE vgi, LOCATION '{MVT_WORKER}', tileset '{MVT_FIXTURES}/does-not-exist.pmtiles');
----
<REGEX>:.*cannot open.*

statement error
ATTACH 'mvt' AS template (TYPE vgi, LOCATION '{MVT_WORKER}', tileset '{MVT_TILE_SERVER}/xyz/{z}/{x}/{y}.mvt');
----
<REGEX>:.*cannot be attached.*

statement error
ATTACH 'mvt' AS badbox (TYPE vgi, LOCATION '{MVT_WORKER}', tileset '{MVT_FIXTURES}/sample.pmtiles', bbox '1,2,3');
----
<REGEX>:.*west,south,east,north.*

statement error
ATTACH 'mvt' AS badedges (TYPE vgi, LOCATION '{MVT_WORKER}', tileset '{MVT_FIXTURES}/sample.pmtiles', tile_edges 'dedupe');
----
<REGEX>:.*tile_edges must be one of.*

statement error
ATTACH 'mvt' AS badcrs (TYPE vgi, LOCATION '{MVT_WORKER}', tileset '{MVT_FIXTURES}/sample.pmtiles', coordinates 'lambert');
----
<REGEX>:.*coordinates must be one of.*
