# name: test/sql/mvt.test
# description: SQL-level tests for the mvt worker, run through DuckDB by ci/run-integration.sh
# group: [mvt]

require vgi

require-env MVT_WORKER

require-env MVT_FIXTURES

require-env MVT_TILE_SERVER

statement ok
ATTACH 'mvt' (TYPE vgi, LOCATION '{MVT_WORKER}');

statement ok
LOAD spatial;

statement ok
LOAD json;

# ---------------------------------------------------------------- tileset_layers

query TTT
SELECT layer, field, type FROM mvt.main.tileset_layers('{MVT_FIXTURES}/sample.pmtiles') ORDER BY layer, field;
----
cities	capital	Boolean
cities	name	String
cities	population	Number
regions	area_rank	Number
regions	code	String
regions	label	String

# ---------------------------------------------------------------- read_tiles

query TII
SELECT layer, count(*), count(DISTINCT geometry_type) FROM mvt.main.read_tiles('{MVT_FIXTURES}/sample.pmtiles', zoom := 2)
GROUP BY layer ORDER BY layer;
----
cities	4	1
regions	2	1

# Default zoom is the tileset maxzoom (3).
query TII
SELECT layer, count(*), max(z) FROM mvt.main.read_tiles('{MVT_FIXTURES}/sample.pmtiles') GROUP BY layer ORDER BY layer;
----
cities	4	3
regions	2	3

query III
SELECT DISTINCT z, x, y FROM mvt.main.read_tiles('{MVT_FIXTURES}/sample.pmtiles', zoom := 2);
----
2	2	1

# layer := adds typed attribute columns from vector_layers.
query TRT
SELECT name, population, capital FROM mvt.main.read_tiles('{MVT_FIXTURES}/sample.pmtiles', layer := 'cities')
ORDER BY population DESC;
----
Berlin	3645000.0	true
Paris	2148000.0	true
Vienna	1897000.0	true
Milan	1352000.0	false

# Properties JSON carries every attribute too.
query TI
SELECT properties->>'name', (properties->>'population')::INTEGER FROM mvt.main.read_tiles('{MVT_FIXTURES}/sample.pmtiles', zoom := 1, layer := 'cities')
WHERE properties->>'name' = 'Milan';
----
Milan	1352000

# Geometry round-trips to WGS84 within the zoom-3 tile grid (~0.011 degrees per pixel).
query TTT
SELECT name, abs(ST_X(geometry) - 13.405) < 0.01, abs(ST_Y(geometry) - 52.52) < 0.01
FROM mvt.main.read_tiles('{MVT_FIXTURES}/sample.pmtiles', zoom := 3, layer := 'cities') WHERE name = 'Berlin';
----
Berlin	true	true

# The square keeps its hole; the triangle has none.
query TTI
SELECT code, geometry_type, ST_NumInteriorRings(geometry) FROM mvt.main.read_tiles('{MVT_FIXTURES}/sample.pmtiles', layer := 'regions')
ORDER BY code;
----
A	POLYGON	1
B	POLYGON	0

# The geometry column is a real GEOMETRY, tagged with its CRS.
query T
SELECT typeof(geometry) FROM mvt.main.read_tiles('{MVT_FIXTURES}/sample.pmtiles', zoom := 0) LIMIT 1;
----
GEOMETRY('OGC:CRS84')

query T
SELECT typeof(geometry) FROM mvt.main.read_tiles('{MVT_FIXTURES}/sample.pmtiles', zoom := 0, coordinates := 'web_mercator') LIMIT 1;
----
GEOMETRY('EPSG:3857')

# Web Mercator metres and raw tile pixels.
query T
SELECT abs(ST_X(geometry) - 1492232) < 2000 FROM mvt.main.read_tiles('{MVT_FIXTURES}/sample.pmtiles', zoom := 3, layer := 'cities', coordinates := 'web_mercator')
WHERE name = 'Berlin';
----
true

query T
SELECT ST_X(geometry) BETWEEN 0 AND 4096 FROM mvt.main.read_tiles('{MVT_FIXTURES}/sample.pmtiles', zoom := 3, layer := 'cities', coordinates := 'tile')
WHERE name = 'Berlin';
----
true

# tile_edges: one row per feature by default ('merge'); 'clip' keeps one piece per tile, and
# 'raw' keeps every tile's copy, buffers included. Merge and clip measure the same; raw counts
# the buffers twice. All three match the Python worker.
query TIRR
SELECT layer, count(*), round(sum(ST_Length(geometry)), 6), round(sum(ST_Area(geometry)), 6)
FROM mvt.main.read_tiles('{MVT_FIXTURES}/edges.pmtiles', zoom := 3) GROUP BY layer ORDER BY layer;
----
areas	2	0.0	265.063188
roads	2	47.568761	0.0

query TIRR
SELECT layer, count(*), round(sum(ST_Length(geometry)), 6), round(sum(ST_Area(geometry)), 6)
FROM mvt.main.read_tiles('{MVT_FIXTURES}/edges.pmtiles', zoom := 3, tile_edges := 'clip') GROUP BY layer ORDER BY layer;
----
areas	5	0.0	265.063188
roads	4	47.571152	0.0

query TIRR
SELECT layer, count(*), round(sum(ST_Length(geometry)), 6), round(sum(ST_Area(geometry)), 6)
FROM mvt.main.read_tiles('{MVT_FIXTURES}/edges.pmtiles', zoom := 3, tile_edges := 'raw') GROUP BY layer ORDER BY layer;
----
areas	5	0.0	315.031777
roads	4	52.319171	0.0

# One row per feature. The fixture's features have no ids, so their pieces join where they
# touch at the tile edge.
query TT
SELECT properties->>'name', geometry_type FROM mvt.main.read_tiles('{MVT_FIXTURES}/edges.pmtiles', zoom := 3) ORDER BY 1;
----
Diagonal	LINESTRING
Four tiles	POLYGON
One tile	POLYGON
Short	LINESTRING

statement error
SELECT * FROM mvt.main.read_tiles('{MVT_FIXTURES}/edges.pmtiles', tile_edges := 'dedupe');
----
<REGEX>:.*tile_edges.*

# A bbox limits which tiles are read: none of the fixture's tiles cover the Pacific.
query I
SELECT count(*) FROM mvt.main.read_tiles('{MVT_FIXTURES}/sample.pmtiles', zoom := 3, west := -170, south := -10, east := -160, north := 0);
----
0

query I
SELECT count(*) FROM mvt.main.read_tiles('{MVT_FIXTURES}/sample.pmtiles', zoom := 3, west := 0, south := 40, east := 30, north := 55);
----
6

# The pushed ST_Intersects box narrows the tiles read (max_tiles := 1 would fail otherwise),
# and lets a {z}/{x}/{y} template run without an explicit bbox.
query I
SELECT count(*) FROM mvt.main.read_tiles('{MVT_FIXTURES}/sample.pmtiles', zoom := 1, layer := 'cities', max_tiles := 1)
WHERE ST_Intersects(geometry, ST_MakeEnvelope(1, 40, 30, 55));
----
4

query I
SELECT count(*) FROM mvt.main.read_tiles('{MVT_TILE_SERVER}/xyz/{z}/{x}/{y}.mvt', zoom := 2, layer := 'cities')
WHERE ST_Intersects(geometry, ST_MakeEnvelope(1, 40, 30, 55));
----
4

# A filter box outside every tile reads nothing.
query I
SELECT count(*) FROM mvt.main.read_tiles('{MVT_FIXTURES}/sample.pmtiles', zoom := 3)
WHERE ST_Intersects(geometry, ST_MakeEnvelope(-170, -10, -160, 0));
----
0

# ---------------------------------------------------------------- remote sources (offline HTTP server)

query TI
SELECT layer, count(*) FROM mvt.main.read_tiles('{MVT_TILE_SERVER}/sample.pmtiles', zoom := 3) GROUP BY layer ORDER BY layer;
----
cities	4
regions	2

query TI
SELECT layer, count(*) FROM mvt.main.read_tiles('{MVT_TILE_SERVER}/xyz/{z}/{x}/{y}.mvt', zoom := 2, west := -180, south := -85, east := 180, north := 85)
GROUP BY layer ORDER BY layer;
----
cities	4
regions	2

query TI
SELECT geometry_type, count(*) FROM mvt.main.read_mvt('{MVT_TILE_SERVER}/0-0-0.mvt', 0, 0, 0) GROUP BY ALL ORDER BY ALL;
----
POINT	4
POLYGON	2

# ---------------------------------------------------------------- read_mvt

query TI
SELECT geometry_type, count(*) FROM mvt.main.read_mvt('{MVT_FIXTURES}/0-0-0.mvt', 0, 0, 0) GROUP BY ALL ORDER BY ALL;
----
POINT	4
POLYGON	2

# Typed columns are inferred from the tile itself.
query TT
SELECT name, typeof(population) FROM mvt.main.read_mvt('{MVT_FIXTURES}/0-0-0.mvt', 0, 0, 0, layer := 'cities') ORDER BY population DESC LIMIT 1;
----
Berlin	BIGINT

statement error
SELECT * FROM mvt.main.read_mvt('{MVT_FIXTURES}/0-0-0.mvt', 1, 5, 0);
----
<REGEX>:.*does not exist.*

# ---------------------------------------------------------------- errors

statement error
SELECT * FROM mvt.main.read_tiles('{MVT_FIXTURES}/sample.pmtiles', layer := 'nope');
----
<REGEX>:.*not in this tileset.*cities, regions.*

statement error
SELECT * FROM mvt.main.read_tiles('{MVT_FIXTURES}/sample.pmtiles', west := 0, south := 0);
----
<REGEX>:.*all four.*

statement error
SELECT * FROM mvt.main.read_tiles('{MVT_FIXTURES}/sample.pmtiles', zoom := 3, west := -180, south := -85, east := 180, north := 85, max_tiles := 1);
----
<REGEX>:.*more than 1 tiles.*

statement error
SELECT * FROM mvt.main.read_tiles('{MVT_FIXTURES}/does-not-exist.pmtiles');
----
<REGEX>:.*cannot open.*

statement error
SELECT * FROM mvt.main.read_tiles('{MVT_FIXTURES}/sample.pmtiles', coordinates := 'lambert');
----
<REGEX>:.*
